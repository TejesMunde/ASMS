def esc(value):
    return html.escape(str(value), quote=True)


def page(title, body, user=None):
    signout = ""
    if user:
        signout = (f'<form method="post" action="/logout"><span>Signed in as <b>{esc(user)}</b></span> '
                   f'<button class="plain" type="submit">Sign out</button></form>')
    return f"""<!doctype html><html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{esc(title)} - ASMS Submissions</title><style>{STYLE}</style></head>
<body><main><header><b>ASMS Submissions</b>{signout}</header>{body}</main></body></html>"""


def message(text):
    return f'<p class="msg" role="alert">{esc(text)}</p>' if text else ""


def login_page(error=""):
    return page("Sign in", f"""
<h1>Sign in to view submissions</h1>
<p>Use the same username and password you use to log in to the server.</p>
{message(error)}
<form method="post" action="/login" class="card">
  <label for="u">Username</label>
  <input id="u" name="username" autocomplete="username" autocapitalize="none" required autofocus>
  <label for="p">Password</label>
  <input id="p" name="password" type="password" autocomplete="current-password" required>
  <p><button type="submit">Sign in</button></p>
</form>""")


def home_page(user):
    rows = []
    for a in all_assignments():
        rows.append(f'<tr><td><b>{esc(a)}</b></td><td>{len(submitted_students(a))}</td>'
                    f'<td><a class="btn" href="/a/{esc(a)}">Open</a></td></tr>')
    body = ("<h1>Assignments</h1>"
            + ("<table><thead><tr><th>Assignment</th><th>Students who submitted</th><th></th>"
               "</tr></thead><tbody>" + "".join(rows) + "</tbody></table>"
               if rows else "<p>No student has submitted anything yet.</p>"))
    return page("Assignments", body, user)


def assignment_page(user, assignment):
    rows = []
    for s in submitted_students(assignment):
        versions = all_versions(s, assignment)
        last = receipt_time(os.path.join(SUBMISSION_ROOT, s, assignment, versions[-1]))
        rows.append(f'<tr><td><b>{esc(s)}</b></td><td>{len(versions)}</td><td>{esc(last)}</td>'
                    f'<td><a class="btn" href="/a/{esc(assignment)}/{esc(s)}">View submission</a></td></tr>')
    body = f"""<p class="crumbs"><a href="/">All assignments</a> &rsaquo; {esc(assignment)}</p>
<h1>{esc(assignment)}</h1>
<table><thead><tr><th>Student</th><th>Attempts</th><th>Last submitted</th><th></th></tr></thead>
<tbody>{"".join(rows)}</tbody></table>"""
    return page(assignment, body, user)


def student_page(user, assignment, student, version=None):
    versions = all_versions(student, assignment)
    latest = versions[-1]
    version = version if version in versions else latest
    vdir = os.path.join(SUBMISSION_ROOT, student, assignment, version)
    base = f"/a/{esc(assignment)}/{esc(student)}"

    def number(v):
        return v[len(VERSION_PREFIX):]

    # Every attempt the student made, newest first.
    attempts = "".join(
        f'<a class="btn{"" if v == version else " plain"}" href="{base}?attempt={esc(v)}"'
        f'{" aria-current=page" if v == version else ""}>Attempt {esc(number(v))}'
        f'{" (latest)" if v == latest else ""}'
        f'<small>{esc(receipt_time(os.path.join(SUBMISSION_ROOT, student, assignment, v)))}</small></a>'
        for v in reversed(versions))

    listing, shown = [], []
    for i, rel in enumerate(submission_files(vdir), 1):
        path = os.path.join(vdir, rel)
        link = f"/f/{esc(assignment)}/{esc(student)}/{esc(version)}/{esc(urllib.parse.quote(rel))}"
        try:
            size = os.path.getsize(path)
            with open(path, "rb") as f:
                data = f.read(MAX_SHOWN_BYTES + 1)
        except OSError:
            continue
        if b"\0" in data[:8192]:
            kind = "Not a text file"
            content = ("<p>This is not a text file, so it cannot be shown here. "
                       "Use <b>Download</b> to open it.</p>")
        else:
            text = data[:MAX_SHOWN_BYTES].decode("utf-8", errors="replace").expandtabs(4)
            lines = text.count("\n") + (1 if text and not text.endswith("\n") else 0)
            kind = f"{lines} line{'' if lines == 1 else 's'}"
            more = ("<p><i>This file is long; only the beginning is shown. Use Download for all of it.</i></p>"
                    if len(data) > MAX_SHOWN_BYTES else "")
            content = f"<pre>{esc(text) or '(empty file)'}</pre>{more}"
        listing.append(f'<tr><td class="name"><a href="#file{i}">{esc(rel)}</a></td>'
                       f'<td>{human_size(size)}</td><td>{kind}</td><td><a href="{link}">Download</a></td></tr>')
        shown.append(f'<div class="file" id="file{i}"><span>{esc(rel)}</span><a href="{link}">Download</a>'
                     f'<a href="#files">Back to file list</a></div>{content}')

    files_table = ('<table><thead><tr><th>File</th><th>Size</th><th>Contents</th><th></th></tr></thead>'
                   f'<tbody>{"".join(listing)}</tbody></table>' if listing else "<p>No files.</p>")

    body = f"""<p class="crumbs"><a href="/">All assignments</a> &rsaquo;
<a href="/a/{esc(assignment)}">{esc(assignment)}</a> &rsaquo; {esc(student)}</p>
<h1>{esc(student)}: {esc(assignment)}</h1>
<dl class="facts card"><dt>Showing</dt><dd>Attempt {esc(number(version))} {"(latest)" if version == latest else "(older)"}</dd>
<dt>Submitted</dt><dd>{esc(receipt_time(vdir))}</dd><dt>Files</dt><dd>{len(listing)}</dd></dl>
<h2>All attempts ({len(versions)})</h2><div class="attempts">{attempts}</div>
<h2 id="files">Submitted files</h2>{files_table}
{"".join(shown)}"""
    return page(f"{student} - {assignment}", body, user)


# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "ASMS"
    sys_version = ""
    timeout = 30   # a client that stops talking frees its thread

    def send(self, status, body, ctype="text/html; charset=utf-8", headers=()):
        data = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(status)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("X-Frame-Options", "DENY")
        self.send_header("Content-Security-Policy",
                         "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; frame-ancestors 'none'")
        for name, value in headers:
            self.send_header(name, value)
        self.end_headers()
        self.wfile.write(data)

    def redirect(self, location, headers=()):
        self.send(303, "", headers=[("Location", location), *headers])

    def token(self):
        for part in self.headers.get("Cookie", "").split(";"):
            name, _, value = part.strip().partition("=")
            if name == "asms_session":
                return value
        return ""

    def user(self):
        return session_user(self.token())

    def form(self):
        length = min(int(self.headers.get("Content-Length") or 0), 64 * 1024)
        return {k: v[0] for k, v in urllib.parse.parse_qs(self.rfile.read(length).decode("utf-8", "replace")).items()}

    def route(self):
        """Decoded path segments. Each is validated by the caller before use."""
        return [urllib.parse.unquote(p) for p in urllib.parse.urlsplit(self.path).path.split("/") if p]

    def log_message(self, fmt, *args):
        pass   # no per-request noise in the journal

    # -- GET ---------------------------------------------------------------

    def do_GET(self):
        parts = self.route()
        if parts == ["login"]:
            return self.send(200, login_page())

        user = self.user()
        if not user:
            return self.redirect("/login")

        if not parts:
            return self.send(200, home_page(user))

        if parts[0] == "a" and len(parts) in (2, 3) and ASSIGNMENT_RE.match(parts[1]):
            assignment = parts[1]
            if len(parts) == 2:
                return self.send(200, assignment_page(user, assignment))
            if self.is_submitted(parts[2], assignment):
                query = urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query)
                attempt = query.get("attempt", [None])[0]   # checked against the real attempts
                return self.send(200, student_page(user, assignment, parts[2], version=attempt))

        if parts[0] == "f" and len(parts) >= 5:
            return self.download(parts[1], parts[2], parts[3], "/".join(parts[4:]))

        self.send(404, page("Not found", '<h1>Page not found</h1><p><a href="/">Back to assignments</a></p>', user))

    def is_submitted(self, student, assignment):
        return (USERNAME_RE.match(student) and student in group_members(STUDENT_GROUP)
                and latest_version(student, assignment) is not None)

    def download(self, assignment, student, version, rel):
        # Served as an attachment and never rendered: a student's .html file
        # opened inline would run with this page's privileges.
        if not (ASSIGNMENT_RE.match(assignment) and self.is_submitted(student, assignment)
                and version in all_versions(student, assignment)):
            return self.send(404, "Not found", "text/plain")
        vdir = os.path.realpath(os.path.join(SUBMISSION_ROOT, student, assignment, version))
        path = os.path.realpath(os.path.join(vdir, rel))
        if not path.startswith(vdir + os.sep) or not os.path.isfile(path):
            return self.send(404, "Not found", "text/plain")
        with open(path, "rb") as f:
            data = f.read()
        name = re.sub(r'[^A-Za-z0-9._-]', "_", os.path.basename(path))
        self.send(200, data, "application/octet-stream",
                  [("Content-Disposition", f'attachment; filename="{name}"')])

    # -- POST --------------------------------------------------------------

    def do_POST(self):
        # Belt and braces with the SameSite=Strict cookie: refuse a form
        # posted from any other site.
        origin = self.headers.get("Origin")
        if origin and urllib.parse.urlsplit(origin).netloc != self.headers.get("Host"):
            return self.send(403, "Forbidden", "text/plain")

        parts = self.route()
        if parts == ["login"]:
            return self.login(self.form())

        if parts == ["logout"]:
            with _state_lock:
                sessions.pop(self.token(), None)
            return self.redirect("/login", [("Set-Cookie", "asms_session=; Max-Age=0; Path=/; Secure; HttpOnly; SameSite=Strict")])

        self.send(404, "Not found", "text/plain")

    def login(self, fields):
        username = fields.get("username", "").strip().lower()
        password = fields.get("password", "")

        if not USERNAME_RE.match(username) or locked_out(username):
            time.sleep(2)
            return self.send(200, login_page("Wrong username or password, or too many attempts. "
                                             "Please wait five minutes and try again."))

        rc = pam_check(username, password)

        # New faculty must set their own password over SSH first; the page
        # cannot do that for them. The password was right, so no failure.
        if rc == PAM_NEW_AUTHTOK_REQD and is_faculty(username):
            return self.send(200, login_page("Your password must be changed before first use. Log in "
                                             "to the server once with SSH to set a new password, then "
                                             "sign in here with it."))

        if not (rc == 0 and is_faculty(username)):
            note_failure(username)
            time.sleep(2)
            return self.send(200, login_page("Wrong username or password, or this is not a faculty account."))

        with _state_lock:
            failures.pop(username, None)
        token = new_session(username)
        self.redirect("/", [("Set-Cookie",
                             f"asms_session={token}; Path=/; Secure; HttpOnly; SameSite=Strict; Max-Age={SESSION_SECONDS}")])


def main():
    server = http.server.ThreadingHTTPServer(("", PORT), Handler)
    context = ssl.SSLContext(ssl.PROTOCOL_TLS_SERVER)
    context.minimum_version = ssl.TLSVersion.TLSv1_2
    context.load_cert_chain(TLS_CERT, TLS_KEY)
    # Handshake in the request thread, not in accept(): otherwise one client
    # that connects and stays silent stalls the page for everyone.
    server.socket = context.wrap_socket(server.socket, server_side=True,
                                        do_handshake_on_connect=False)
    print(f"ASMS submissions page listening on https port {PORT}", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
