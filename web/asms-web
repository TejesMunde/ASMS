#!/usr/bin/env python3
#
# Assignment Server Management System (ASMS)
# asms-web -- read-only submissions viewer for faculty
# Version: 2.0.0
#
# Faculty open https://<server>:<port>/ and sign in with their normal Linux
# username and password. They pick an assignment and a student, and see
# every attempt the student submitted: the list of files and each file's
# contents. Students are refused at sign-in even with a correct password.
#
# It never writes anything. Runs as the unprivileged `asms-web` account;
# systemd grants it two supplementary groups and nothing else:
#   faculty -- the g:faculty:rX ACL on every archive lets it read submissions.
#   shadow  -- pam_unix reads /etc/shadow to check passwords.
#
# Standard library only. PAM is called through ctypes because the Python PAM
# bindings are not reliably packaged across Ubuntu/Debian releases.
#
# @...@ values are substituted by install.sh. The service cannot read
# config.conf (root-only), so nothing is read from it at runtime.
#

import ctypes
import ctypes.util
import grp
import html
import http.server
import os
import pwd
import re
import secrets
import ssl
import threading
import time
import urllib.parse

SUBMISSION_ROOT = "@SUBMISSION_ROOT@"
STUDENT_GROUP = "@STUDENT_GROUP@"
FACULTY_GROUP = "@FACULTY_GROUP@"
VERSION_PREFIX = "@SUBMISSION_VERSION_PREFIX@"
PORT = int("@WEB_PORT@")
TLS_CERT = "@WEB_DIR@/tls.crt"
TLS_KEY = "@WEB_DIR@/tls.key"

SESSION_SECONDS = 4 * 3600
MAX_SHOWN_BYTES = 200_000

# Same rules as validate_username / validate_assignment_name in utils.sh.
# Everything that becomes part of a path is checked against these first.
USERNAME_RE = re.compile(r"^[a-z_][a-z0-9_-]{0,31}$")
ASSIGNMENT_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")


# ---------------------------------------------------------------------------
# PAM
# ---------------------------------------------------------------------------

class PamMessage(ctypes.Structure):
    _fields_ = [("msg_style", ctypes.c_int), ("msg", ctypes.c_char_p)]


class PamResponse(ctypes.Structure):
    _fields_ = [("resp", ctypes.c_void_p), ("resp_retcode", ctypes.c_int)]


CONV_FUNC = ctypes.CFUNCTYPE(
    ctypes.c_int, ctypes.c_int,
    ctypes.POINTER(ctypes.POINTER(PamMessage)),
    ctypes.POINTER(ctypes.POINTER(PamResponse)),
    ctypes.c_void_p)


class PamConv(ctypes.Structure):
    _fields_ = [("conv", CONV_FUNC), ("appdata_ptr", ctypes.c_void_p)]


_libc = ctypes.CDLL(ctypes.util.find_library("c"))
_libc.calloc.restype = ctypes.c_void_p
_libc.calloc.argtypes = [ctypes.c_size_t, ctypes.c_size_t]

_pam = ctypes.CDLL(ctypes.util.find_library("pam"))
_pam.pam_start.restype = ctypes.c_int
_pam.pam_start.argtypes = [ctypes.c_char_p, ctypes.c_char_p,
                           ctypes.POINTER(PamConv), ctypes.POINTER(ctypes.c_void_p)]
for _fn in (_pam.pam_authenticate, _pam.pam_acct_mgmt, _pam.pam_end):
    _fn.restype = ctypes.c_int
    _fn.argtypes = [ctypes.c_void_p, ctypes.c_int]

PAM_PROMPT_ECHO_OFF = 1
PAM_NEW_AUTHTOK_REQD = 12   # right password, but it must be changed first
PAM_SERVICE = b"asms-web"

# ponytail: one sign-in check at a time; parallel PAM only matters at a scale
# a department server never sees.
_pam_lock = threading.Lock()


def pam_check(username, password):
    """The PAM result code: 0 means signed in."""
    secret = password.encode()

    @CONV_FUNC
    def conv(count, messages, response_out, _appdata):
        # PAM frees these with free(), so they must come from calloc.
        responses = ctypes.cast(_libc.calloc(count, ctypes.sizeof(PamResponse)),
                                ctypes.POINTER(PamResponse))
        for i in range(count):
            if messages[i].contents.msg_style == PAM_PROMPT_ECHO_OFF:
                buf = _libc.calloc(len(secret) + 1, 1)
                ctypes.memmove(buf, secret, len(secret))
                responses[i].resp = buf
        response_out[0] = responses
        return 0

    handle = ctypes.c_void_p()
    with _pam_lock:
        if _pam.pam_start(PAM_SERVICE, username.encode(),
                          ctypes.byref(PamConv(conv, None)), ctypes.byref(handle)) != 0:
            return -1
        rc = _pam.pam_authenticate(handle, 0)
        if rc == 0:
            rc = _pam.pam_acct_mgmt(handle, 0)   # expired or locked accounts
        _pam.pam_end(handle, rc)
    return rc


# ---------------------------------------------------------------------------
# Accounts and submissions
# ---------------------------------------------------------------------------

def group_members(group):
    """Primary and supplementary members, like get_users_in_group in utils.sh.
    Students' group is their PRIMARY group, so gr_mem alone lists nobody."""
    try:
        g = grp.getgrnam(group)
    except KeyError:
        return set()
    return set(g.gr_mem) | {p.pw_name for p in pwd.getpwall() if p.pw_gid == g.gr_gid}


def is_faculty(username):
    return username in group_members(FACULTY_GROUP) and username not in group_members(STUDENT_GROUP)


def subdirs(path):
    try:
        return sorted(e.name for e in os.scandir(path) if e.is_dir(follow_symlinks=False))
    except OSError:
        return []


def all_versions(student, assignment):
    """Every submission-NNN of a student's assignment, oldest first."""
    return [v for v in subdirs(os.path.join(SUBMISSION_ROOT, student, assignment))
            if v.startswith(VERSION_PREFIX)]   # zero-padded, so sort works


def latest_version(student, assignment):
    versions = all_versions(student, assignment)
    return versions[-1] if versions else None


def human_size(n):
    if n < 1024:
        return f"{n} bytes"
    return f"{n / 1024:.1f} KB" if n < 1024 * 1024 else f"{n / 1024 / 1024:.1f} MB"


def submitted_students(assignment):
    return [s for s in sorted(group_members(STUDENT_GROUP))
            if USERNAME_RE.match(s) and latest_version(s, assignment)]


def all_assignments():
    # /srv/submissions is traverse-only, so walk the known students' archives.
    names = set()
    for s in group_members(STUDENT_GROUP):
        if USERNAME_RE.match(s):
            names.update(subdirs(os.path.join(SUBMISSION_ROOT, s)))
    return sorted(n for n in names if ASSIGNMENT_RE.match(n))


def submission_files(version_dir):
    """Relative paths of submitted files, excluding ASMS's own metadata."""
    files = []
    for root, dirs, names in os.walk(version_dir):
        dirs[:] = sorted(d for d in dirs if not (root == version_dir and d == "metadata"))
        for n in sorted(names):
            files.append(os.path.relpath(os.path.join(root, n), version_dir))
    return files


def receipt_time(version_dir):
    try:
        with open(os.path.join(version_dir, "metadata", "receipt.txt"), encoding="utf-8") as f:
            for line in f:
                if line.startswith("Submitted"):
                    return line.split(":", 1)[1].strip()
    except OSError:
        pass
    return "unknown"


# ---------------------------------------------------------------------------
# Sessions and sign-in throttling
# ---------------------------------------------------------------------------

sessions = {}            # token -> (username, expires)
failures = {}            # username -> (count, locked_until)
_state_lock = threading.Lock()


def new_session(username):
    token = secrets.token_urlsafe(32)
    with _state_lock:
        sessions[token] = (username, time.time() + SESSION_SECONDS)
    return token


def session_user(token):
    with _state_lock:
        entry = sessions.get(token)
        if entry and entry[1] > time.time():
            return entry[0]
        sessions.pop(token, None)
    return None


def locked_out(username):
    with _state_lock:
        count, until = failures.get(username, (0, 0))
        return until > time.time()


def note_failure(username):
    # Five wrong passwords lock that username out of the web page for five
    # minutes, so a student cannot guess a faculty password from here.
    with _state_lock:
        count, _ = failures.get(username, (0, 0))
        count += 1
        failures[username] = (0, time.time() + 300) if count >= 5 else (count, 0)


